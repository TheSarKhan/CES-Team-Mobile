    "expo": "^57.0.20",
    "expo-audio": "~57.0.5",
    "expo-build-properties": "~57.0.17",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.17",
    "expo-device": "~57.0.1",
    "expo-document-picker": "~57.0.3",
